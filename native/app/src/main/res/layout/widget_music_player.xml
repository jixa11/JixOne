<?xml version="1.0" encoding="utf-8"?>
<!-- JixOne player widget: the cover, blurred, fills the whole widget under a
     dark scrim; cover, title and artist on top, then one row of controls and a
     thin progress line. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/jw_base"
    android:clipToOutline="true"
    android:theme="@style/Theme.Widget.JixOne">

    <ImageView
        android:id="@+id/widget_bg_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/jw_scrim"
        android:scaleType="fitXY"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_album_art"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/album_art" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_song_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/not_playing"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_artist_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tap_to_play"
                    android:textSize="13sp"
                    android:textColor="#CCFFFFFF"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/widget_like_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:background="@drawable/jw_round_bg"
                android:src="@drawable/jw_heart"
                android:contentDescription="@string/like" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp">

            <ImageView
                android:id="@+id/widget_progress_track"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/jw_progress_track"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/widget_progress_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/jw_progress_clip"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/widget_prev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:background="@drawable/jw_round_bg"
                android:src="@drawable/jw_prev"
                android:contentDescription="@string/previous" />

            <FrameLayout
                android:id="@+id/widget_play_pause_container"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"
                android:background="@drawable/jw_play_bg">

                <ImageView
                    android:id="@+id/widget_play_pause"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/jw_play"
                    android:contentDescription="@string/play_pause" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:background="@drawable/jw_round_bg"
                android:src="@drawable/jw_next"
                android:contentDescription="@string/next" />
        </LinearLayout>

        <!-- The queue: hidden at the default height, shown when the widget is
             stretched taller. A taller widget shows more songs; the player
             block above keeps its size. -->
        <ListView
            android:id="@+id/widget_queue"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:divider="@null"
            android:scrollbars="none"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
